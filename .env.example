# Postgres connection string from Neon (https://neon.tech)
# Format: postgresql://user:pass@host/db?sslmode=require
DATABASE_URL=

# Anthropic API key for invoice OCR extraction (Claude vision)
# Get one at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Vercel Blob token for storing uploaded invoice files
# Created automatically when you connect a Blob store in the Vercel dashboard
BLOB_READ_WRITE_TOKEN=
